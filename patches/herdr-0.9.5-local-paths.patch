+/// Recognize plain ASCII paths without changing the terminal's displayed text.
+pub(super) fn terminal_link_byte_range(
+    text: &str,
+    clicked_byte: usize,
+) -> Option<std::ops::Range<usize>> {
+    if let Some(range) = url_byte_range(text, clicked_byte) {
+        return Some(range);
+    }
+    for quote in ['"', '\''] {
+        if let Some(start) = text.get(..clicked_byte)?.rfind(quote) {
+            let start = start + 1;
+            if let Some(end) = text[start..].find(quote).map(|end| start + end) {
+                let candidate = &text[start..end];
+                if clicked_byte < end
+                    && candidate.is_ascii()
+                    && !candidate.chars().any(char::is_control)
+                    && !candidate.contains("://")
+                    && (candidate.contains('/') || candidate.contains('.'))
+                {
+                    return Some(start..end);
+                }
+            }
+        }
+    }
+    let allowed = |byte: u8| byte.is_ascii_alphanumeric() || b"/._~-:".contains(&byte);
+    let bytes = text.as_bytes();
+    if !bytes.get(clicked_byte).copied().is_some_and(allowed) {
+        return None;
+    }
+    let mut start = clicked_byte;
+    while start > 0 && allowed(bytes[start - 1]) {
+        start -= 1;
+    }
+    let mut end = clicked_byte + 1;
+    while end < bytes.len() && allowed(bytes[end]) {
+        end += 1;
+    }
+    if (start > 0 && !bytes[start - 1].is_ascii()) || (end < bytes.len() && !bytes[end].is_ascii())
+    {
+        return None;
+    }
+    let candidate = &text[start..end];
+    if candidate.contains("://")
+        || candidate == "."
+        || candidate == ".."
+        || (!candidate.contains('/') && !candidate.contains('.'))
+    {
+        return None;
+    }
+    Some(start..end)
+}
