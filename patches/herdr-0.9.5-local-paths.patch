+#[cfg(test)]
+mod local_path_link_tests {
+    use super::terminal_link_byte_range;
+
+    #[test]
+    fn plain_paths_keep_their_display_text_and_urls_keep_priority() {
+        for path in [
+            "plans/task/plan.md",
+            "/tmp/report.md",
+            "../docs/",
+            "README.md",
+            "./src/main.rs:12:3",
+            "https://example.com/doc",
+        ] {
+            let text = format!("see {path} now");
+            let range = terminal_link_byte_range(&text, 5).unwrap();
+            assert_eq!(&text[range], path);
+        }
+        let text = "see \"docs/a report.md\" now";
+        let range = terminal_link_byte_range(text, 14).unwrap();
+        assert_eq!(&text[range], "docs/a report.md");
+    }
+
+    #[test]
+    fn ordinary_words_and_partial_unicode_paths_are_not_links() {
+        assert!(terminal_link_byte_range("ordinary", 2).is_none());
+        assert!(terminal_link_byte_range("báo.md", 5).is_none());
+        assert!(terminal_link_byte_range("ssh://host/tmp/file", 14).is_none());
+    }
+}
